<Project Sdk="Microsoft.NET.Sdk">
  
    <PropertyGroup>
        <RootNamespace>NUnit.Engine</RootNamespace>
        <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NUnit.Engine.API.Tests, PublicKey=$(NUnitPublicKey)" />
	</ItemGroup>
	
    <PropertyGroup>
        <PackageId>NUnit.Engine.Api</PackageId>
        <AssemblyTitle>NUnit Engine API ($(TargetFramework))</AssemblyTitle>
        <Description>Defines the interfaces used by runners and engine extensions to access the NUnit Engine. Not normally needed by direct users who simply want to run tests.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit.Extensibility.Api" />
    </ItemGroup>

</Project>
